+
+// InvoiceBatch totals what a set of customers owes.
+func (s *Service) InvoiceBatch(ctx context.Context, ids []string) (int64, error) {
+	var total int64
+	for _, id := range ids {
+		c, _ := s.store.Customer(ctx, id)
+		total += c.Plan.CentsDue - c.Balance
+	}
+	return total, nil
+}
