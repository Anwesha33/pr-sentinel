# Required by the worker.
GEMINI_API_KEY=
# An alias rather than a pinned id: pinned Gemini model ids get retired, which
# is exactly how this project's first evaluation run failed.
GEMINI_MODEL=gemini-flash-latest

# Needed to review private repositories and to post reviews at all.
# A fine-grained token with "Pull requests: read and write" on the target repo.
GITHUB_TOKEN=

# When set, /webhooks/github rejects requests whose HMAC does not match.
GITHUB_WEBHOOK_SECRET=

# Safety default. Set to false to actually publish reviews to GitHub.
DRY_RUN=true
